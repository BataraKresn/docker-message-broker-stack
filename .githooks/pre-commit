#!/bin/bash
# Pre-commit hook to validate docker-compose files and shell scripts
set -e

echo "Running pre-commit checks..."

# 1. Validate shell scripts
echo "[1/3] Validating shell scripts..."
for script in scripts/*.sh; do
  if [[ -f "$script" ]]; then
    if ! bash -n "$script" 2>/dev/null; then
      echo "✗ Syntax error in $script"
      exit 1
    fi
  fi
done
echo "✓ Shell scripts are valid"

# 2. Validate docker-compose files
echo "[2/3] Validating docker-compose files..."
if ! docker compose -f docker-compose.dev.yml --env-file .env.dev.example config > /dev/null 2>&1; then
  echo "✗ docker-compose.dev.yml is invalid"
  exit 1
fi
if ! docker compose -f docker-compose.prod.yml --env-file .env.prod.example config > /dev/null 2>&1; then
  echo "✗ docker-compose.prod.yml is invalid"
  exit 1
fi
if ! docker compose -f docker-compose.monitoring.yml --env-file .env.prod.example config > /dev/null 2>&1; then
  echo "✗ docker-compose.monitoring.yml is invalid"
  exit 1
fi
echo "✓ Docker Compose files are valid"

# 3. Check for uncommitted .env files
echo "[3/3] Checking for .env files..."
if [[ -f .env ]] || [[ -f .env.dev ]] || [[ -f .env.prod ]]; then
  echo "✓ .env files present (will not be committed)"
else
  echo "⚠ Warning: No .env files found (run 'make init-env' if needed)"
fi

echo ""
echo "✓ All pre-commit checks passed"
