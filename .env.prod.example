# General
COMPOSE_PROJECT_NAME=message-broker-stack
TZ=Asia/Jakarta

# Redis
REDIS_PASSWORD=prod_redis_password_must_be_strong
REDIS_MASTER_HOST=redis-master
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379
REDIS_MASTER_SET=mymaster

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=prod_rabbitmq_password_must_be_strong
RABBITMQ_DEFAULT_VHOST=app
RABBITMQ_ERLANG_COOKIE=prod_erlang_cookie_must_be_long_random
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# Kafka
KAFKA_CLUSTER_ID=change_me_kraft_cluster_id_base64_or_uuid
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_NUM_PARTITIONS=3
KAFKA_RETENTION_HOURS=168

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=prod_grafana_password_must_be_strong
