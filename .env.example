# General
COMPOSE_PROJECT_NAME=message-broker-stack
TZ=Asia/Jakarta

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_MASTER_HOST=redis-master
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379
REDIS_MASTER_SET=mymaster

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=app
RABBITMQ_ERLANG_COOKIE=change_me_erlang_cookie
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# Kafka
KAFKA_CLUSTER_ID=change_me_kraft_cluster_id
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_NUM_PARTITIONS=3
KAFKA_RETENTION_HOURS=168

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
